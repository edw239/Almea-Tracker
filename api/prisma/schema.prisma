generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GLOBAL_ADMIN
  PROJECT_MANAGER
  MEMBER
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskSpaceMemberRole {
  OWNER
  MEMBER
  VIEWER
}

enum TaskViewType {
  LIST
  BOARD
  CALENDAR
  TABLE
}

enum TaskGroupBy {
  NONE
  STATUS
  PRIORITY
  ASSIGNEE
  DUE_DATE
}

enum TaskRelationType {
  BLOCKS
  RELATES
}

enum ScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum FavoriteEntityType {
  TASK_LIST
  TASK
  TASK_VIEW
  BOARD
}

enum BoardType {
  KANBAN
  SCRUM
}

enum BoardSwimlane {
  NONE
  ASSIGNEE
  EPIC
  BRAND
  PRIORITY
  QUERIES
}

enum BoardCardColor {
  NONE
  PRIORITY
  TYPE
  ASSIGNEE
}

enum SprintState {
  FUTURE
  ACTIVE
  CLOSED
}

enum SprintEventType {
  COMMITTED
  ADDED
  REMOVED
  ESTIMATE_CHANGED
  DONE
  REOPENED
  CLOSED_DONE
  CLOSED_INCOMPLETE
}

enum NotificationCode {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_MENTION
  TASK_COMMENT
  TASK_REMINDER
  TASK_STATUS_CHANGED
  TASK_REVIEW_REQUESTED
  TASK_STUCK
}

enum NotificationSeverity {
  LOW
  MEDIUM
  HIGH
}

model UserNotificationSetting {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  code      NotificationCode
  inApp     Boolean          @default(true) @map("in_app")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId])
  @@map("user_notification_settings")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  passwordHash        String    @map("password_hash")
  name                String
  role                UserRole  @default(MEMBER)
  timezone            String    @default("Asia/Dubai")
  locale              String    @default("ru")
  jobTitle            String?   @map("job_title")
  passwordChangedAt   DateTime? @map("password_changed_at")
  quietHoursFrom      Int?      @map("quiet_hours_from")
  quietHoursTo        Int?      @map("quiet_hours_to")
  snoozeHoursDefault  Int?      @map("snooze_hours_default")
  isActive            Boolean   @default(true) @map("is_active")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  createdByUserId     String?   @map("created_by_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  createdBy              User?                     @relation("UserProvisioner", fields: [createdByUserId], references: [id], onDelete: SetNull)
  provisionedUsers       User[]                    @relation("UserProvisioner")
  spaceMembers           TaskSpaceMember[]
  ownedTasks             Task[]                    @relation("TaskOwner")
  assignments            TaskAssignee[]
  watchers               TaskWatcher[]
  comments               TaskComment[]
  activities             TaskActivity[]
  viewPreferences        TaskViewPreference[]
  ownedViews             TaskView[]
  favorites              UserFavorite[]
  notifications          TaskNotification[]
  createdTemplates       TaskTemplate[]
  notificationSettings   UserNotificationSetting[]
  createdTasks           Task[]                    @relation("TaskCreator")
  assignedSchedules      TaskSchedule[]            @relation("ScheduleAssignee")
  stuckTasks             Task[]                    @relation("TaskStuckBy")
  ownedBoards            Board[]

  @@index([isActive])
  @@map("users")
}

model TaskSpace {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  color       String?
  icon        String?
  isSystem    Boolean  @default(false) @map("is_system")
  systemKey   String?  @unique @map("system_key")
  key         String   @unique @db.VarChar(10)
  taskSeq     Int      @default(0) @map("task_seq")
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members   TaskSpaceMember[]
  folders   TaskFolder[]
  lists     TaskList[]
  statuses  TaskListStatus[]
  templates    TaskTemplate[]
  taskTypes    TaskType[]
  boardSources BoardSource[]

  @@map("task_spaces")
}

model TaskType {
  id        String   @id @default(uuid()) @db.Uuid
  spaceId   String   @map("space_id") @db.Uuid
  key       String   @db.VarChar(40)
  name      String   @db.VarChar(80)
  color     String?  @db.VarChar(20)
  isSystem  Boolean  @default(false) @map("is_system")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  space TaskSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([spaceId, key])
  @@index([spaceId, position])
  @@map("task_types")
}

model TaskSpaceMember {
  spaceId   String              @map("space_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  role      TaskSpaceMemberRole
  createdAt DateTime            @default(now()) @map("created_at")

  space TaskSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([spaceId, userId])
  @@map("task_space_members")
}

model TaskFolder {
  id         String   @id @default(uuid()) @db.Uuid
  spaceId    String   @map("space_id") @db.Uuid
  name       String
  position   Float
  isArchived Boolean  @default(false) @map("is_archived")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  space        TaskSpace     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  lists        TaskList[]
  boardSources BoardSource[]

  @@index([spaceId, position])
  @@map("task_folders")
}

model TaskList {
  id             String   @id @default(uuid()) @db.Uuid
  spaceId        String   @map("space_id") @db.Uuid
  folderId       String?  @map("folder_id") @db.Uuid
  name           String
  position       Float
  systemKey      String?  @map("system_key")
  domainEntityId String?  @map("domain_entity_id")
  hostEntityId   String?  @map("host_entity_id") @db.Uuid
  isArchived     Boolean  @default(false) @map("is_archived")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  space            TaskSpace            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  folder           TaskFolder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  hostEntity       HostEntity?          @relation(fields: [hostEntityId], references: [id], onDelete: SetNull)
  tasks            Task[]
  statuses         TaskListStatus[]
  viewPreferences  TaskViewPreference[]
  views            TaskView[]
  templates         TaskTemplate[]
  schedules         TaskSchedule[]
  boardSources      BoardSource[]
  defaultForBoards  Board[]          @relation("BoardDefaultList")

  @@unique([spaceId, systemKey])
  @@index([spaceId, position])
  @@index([hostEntityId])
  @@map("task_lists")
}

model TaskListStatus {
  id        String     @id @default(uuid()) @db.Uuid
  spaceId   String     @map("space_id") @db.Uuid
  listId    String?    @map("list_id") @db.Uuid
  name      String
  color     String
  order     Int
  category  TaskStatus
  isDefault Boolean    @default(false) @map("is_default")
  isBacklog Boolean    @default(false) @map("is_backlog")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  space TaskSpace  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  list  TaskList?  @relation(fields: [listId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([listId, order])
  @@index([spaceId, order])
  @@map("task_list_statuses")
}

model Task {
  id               String       @id @default(uuid()) @db.Uuid
  listId           String       @map("list_id") @db.Uuid
  parentTaskId     String?      @map("parent_task_id") @db.Uuid
  ownerUserId      String?      @map("owner_user_id") @db.Uuid
  createdByUserId  String?      @map("created_by_user_id") @db.Uuid
  title            String       @db.VarChar(500)
  description      String?
  status           TaskStatus   @default(OPEN)
  listStatusId     String?      @map("list_status_id") @db.Uuid
  priority         TaskPriority @default(MEDIUM)
  dueDate          DateTime?    @map("due_date")
  startDate        DateTime?    @map("start_date")
  completedAt      DateTime?    @map("completed_at")
  reviewRequired   Boolean      @default(false) @map("review_required")
  submittedAt      DateTime?    @map("submitted_at")
  position         Float
  deletedAt        DateTime?    @map("deleted_at")
  domainEntityId   String?      @map("domain_entity_id")
  domainEntityType String?      @map("domain_entity_type") @db.VarChar(40)
  domainLabel      String?      @map("domain_label") @db.VarChar(200)
  hostEntityId     String?      @map("host_entity_id") @db.Uuid
  taskTypeId       String?      @map("task_type_id") @db.Uuid
  isStuck          Boolean      @default(false) @map("is_stuck")
  stuckAt          DateTime?    @map("stuck_at")
  stuckReason      String?      @map("stuck_reason") @db.VarChar(500)
  stuckByUserId    String?      @map("stuck_by_user_id") @db.Uuid
  dueDateMoveCount Int          @default(0) @map("due_date_move_count")
  key              String       @unique @db.VarChar(24)
  rank             String       @unique @db.VarChar(64)
  statusChangedAt  DateTime     @default(now()) @map("status_changed_at")
  epicId           String?      @map("epic_id") @db.Uuid
  storyPoints      Decimal?     @map("story_points") @db.Decimal(5, 1)
  sprintId         String?      @map("sprint_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  list          TaskList          @relation(fields: [listId], references: [id], onDelete: Restrict)
  parent        Task?             @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  children      Task[]            @relation("Subtasks")
  owner         User?             @relation("TaskOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdBy     User?             @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  stuckBy       User?             @relation("TaskStuckBy", fields: [stuckByUserId], references: [id], onDelete: SetNull)
  hostEntity    HostEntity?       @relation(fields: [hostEntityId], references: [id], onDelete: SetNull)
  taskType      TaskType?         @relation(fields: [taskTypeId], references: [id], onDelete: SetNull)
  listStatus    TaskListStatus?   @relation(fields: [listStatusId], references: [id], onDelete: SetNull)
  assignees     TaskAssignee[]
  watchers      TaskWatcher[]
  comments      TaskComment[]
  checklist     ChecklistItem[]
  activities    TaskActivity[]
  relationsFrom TaskRelation[]    @relation("RelationFrom")
  relationsTo   TaskRelation[]    @relation("RelationTo")
  notifications TaskNotification[]
  scheduleRuns      TaskScheduleRun[]
  epic              Task?                 @relation("TaskEpic", fields: [epicId], references: [id], onDelete: SetNull)
  epicChildren      Task[]                @relation("TaskEpic")
  keyAliases        TaskKeyAlias[]
  statusTransitions TaskStatusTransition[]
  labels            TaskLabel[]
  sprint            Sprint?               @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  sprintEvents      SprintEvent[]

  @@index([listId, deletedAt])
  @@index([listId, position])
  @@index([listId, listStatusId])
  @@index([ownerUserId, deletedAt])
  @@index([createdByUserId])
  @@index([parentTaskId])
  @@index([dueDate])
  @@index([domainEntityType, domainEntityId])
  @@index([hostEntityId])
  @@index([reviewRequired, status])
  @@index([isStuck])
  @@index([taskTypeId])
  @@index([dueDateMoveCount])
  @@index([epicId])
  @@index([sprintId])
  @@index([rank])
  @@map("tasks")
}

model HostEntity {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(40)
  name        String   @db.VarChar(200)
  nameKey     String   @map("name_key") @db.VarChar(200)
  externalKey String?  @map("external_key") @db.VarChar(100)
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tasks Task[]
  lists TaskList[]

  @@unique([entityType, nameKey])
  @@index([entityType, isArchived])
  @@map("host_entities")
}

model TaskNotification {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  code         NotificationCode
  severity     NotificationSeverity @default(LOW)
  title        String               @db.VarChar(200)
  body         String               @db.VarChar(1000)
  taskId       String?              @map("task_id") @db.Uuid
  readAt       DateTime?            @map("read_at")
  snoozedUntil DateTime?            @map("snoozed_until")
  clearedAt    DateTime?            @map("cleared_at")
  dedupKey     String?              @map("dedup_key") @db.VarChar(200)
  createdAt    DateTime             @default(now()) @map("created_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupKey])
  @@index([userId, clearedAt, createdAt])
  @@map("task_notifications")
}

model TaskAssignee {
  taskId     String   @map("task_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_assignees")
}

model TaskWatcher {
  taskId    String   @map("task_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_watchers")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model ChecklistItem {
  id             String   @id @default(uuid()) @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  text           String
  isDone         Boolean  @default(false) @map("is_done")
  position       Int
  assigneeUserId String?  @map("assignee_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
  @@map("checklist_items")
}

model TaskRelation {
  id           String           @id @default(uuid()) @db.Uuid
  fromTaskId   String           @map("from_task_id") @db.Uuid
  toTaskId     String           @map("to_task_id") @db.Uuid
  relationType TaskRelationType @map("relation_type")
  createdAt    DateTime         @default(now()) @map("created_at")

  fromTask Task @relation("RelationFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTask   Task @relation("RelationTo", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([fromTaskId, toTaskId, relationType])
  @@map("task_relations")
}

model TaskActivity {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([userId, createdAt])
  @@map("task_activities")
}

model TaskViewPreference {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  listId    String       @map("list_id") @db.Uuid
  viewType  TaskViewType @default(LIST) @map("view_type")
  groupBy   TaskGroupBy  @default(NONE) @map("group_by")
  sort      Json?
  filters   Json?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  list TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@map("task_view_preferences")
}

model TaskView {
  id        String       @id @default(uuid()) @db.Uuid
  listId    String       @map("list_id") @db.Uuid
  ownerId   String       @map("owner_id") @db.Uuid
  name      String
  viewType  TaskViewType @map("view_type")
  groupBy   TaskGroupBy  @default(NONE) @map("group_by")
  sort      Json?
  filters   Json?
  columns   Json?
  isShared  Boolean      @default(false) @map("is_shared")
  position  Float
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  list  TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)
  owner User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([listId, position])
  @@map("task_views")
}

model TaskTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  spaceId   String?  @map("space_id") @db.Uuid
  listId    String?  @map("list_id") @db.Uuid
  name      String   @db.VarChar(120)
  items     Json
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  space   TaskSpace? @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  list    TaskList?  @relation(fields: [listId], references: [id], onDelete: Cascade)
  creator User?      @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  schedules TaskSchedule[]

  @@index([spaceId, isActive])
  @@index([listId, isActive])
  @@map("task_templates")
}

model TaskSchedule {
  id             String            @id @default(uuid()) @db.Uuid
  listId         String            @map("list_id") @db.Uuid
  templateId     String?           @map("template_id") @db.Uuid
  title          String            @db.VarChar(200)
  frequency      ScheduleFrequency
  byWeekday      Int?              @map("by_weekday") @db.SmallInt
  byMonthday     Int?              @map("by_monthday") @db.SmallInt
  atMinute       Int               @map("at_minute")
  timezone       String
  assigneeUserId String?           @map("assignee_user_id") @db.Uuid
  dueInDays      Int?              @map("due_in_days")
  isActive       Boolean           @default(true) @map("is_active")
  nextRunAt      DateTime          @map("next_run_at")
  lastRunAt      DateTime?         @map("last_run_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  list     TaskList          @relation(fields: [listId], references: [id], onDelete: Cascade)
  template TaskTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  assignee User?             @relation("ScheduleAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  runs     TaskScheduleRun[]

  @@index([nextRunAt], map: "task_schedules_next_run_at_idx")
  @@map("task_schedules")
}

model TaskScheduleRun {
  scheduleId String   @map("schedule_id") @db.Uuid
  periodKey  String   @map("period_key") @db.VarChar(40)
  taskId     String?  @map("task_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  schedule TaskSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  task     Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@id([scheduleId, periodKey])
  @@map("task_schedule_runs")
}

model UserFavorite {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  entityType FavoriteEntityType @map("entity_type")
  entityId   String             @map("entity_id") @db.Uuid
  position   Float              @default(1000)
  createdAt  DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId, position])
  @@map("user_favorites")
}

model TaskKeyAlias {
  key       String   @id @db.VarChar(24)
  taskId    String   @map("task_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_key_aliases")
}

model TaskStatusTransition {
  id               String      @id @default(uuid()) @db.Uuid
  taskId           String      @map("task_id") @db.Uuid
  fromStatus       TaskStatus? @map("from_status")
  fromListStatusId String?     @map("from_list_status_id") @db.Uuid
  fromCategory     TaskStatus? @map("from_category")
  toStatus         TaskStatus  @map("to_status")
  toListStatusId   String?     @map("to_list_status_id") @db.Uuid
  toCategory       TaskStatus  @map("to_category")
  actorUserId      String?     @map("actor_user_id") @db.Uuid
  reason           String      @db.VarChar(40)
  createdAt        DateTime    @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([toCategory, createdAt])
  @@map("task_status_transitions")
}

model Board {
  id              String         @id @default(uuid()) @db.Uuid
  name            String         @db.VarChar(120)
  type            BoardType
  ownerId         String         @map("owner_id") @db.Uuid
  filter          Json?
  swimlaneBy      BoardSwimlane  @default(NONE) @map("swimlane_by")
  swimlaneQueries Json?          @map("swimlane_queries")
  backlogEnabled  Boolean        @default(false) @map("backlog_enabled")
  doneHideDays    Int?           @map("done_hide_days")
  defaultListId   String?        @map("default_list_id") @db.Uuid
  cardColorBy     BoardCardColor @default(NONE) @map("card_color_by")
  cardFields      Json?          @map("card_fields")
  isArchived      Boolean        @default(false) @map("is_archived")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  defaultList  TaskList?          @relation("BoardDefaultList", fields: [defaultListId], references: [id], onDelete: SetNull)
  sources      BoardSource[]
  columns      BoardColumn[]
  quickFilters BoardQuickFilter[]
  sprints      Sprint[]

  @@index([ownerId])
  @@map("boards")
}

model BoardSource {
  id       String  @id @default(uuid()) @db.Uuid
  boardId  String  @map("board_id") @db.Uuid
  spaceId  String? @map("space_id") @db.Uuid
  folderId String? @map("folder_id") @db.Uuid
  listId   String? @map("list_id") @db.Uuid

  board  Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  space  TaskSpace?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  folder TaskFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  list   TaskList?   @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@index([spaceId])
  @@index([folderId])
  @@index([listId])
  @@map("board_sources")
}

model BoardColumn {
  id          String   @id @default(uuid()) @db.Uuid
  boardId     String   @map("board_id") @db.Uuid
  name        String   @db.VarChar(80)
  position    Float
  statusNames String[] @map("status_names")
  minWip      Int?     @map("min_wip")
  maxWip      Int?     @map("max_wip")

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, position])
  @@map("board_columns")
}

model BoardQuickFilter {
  id       String @id @default(uuid()) @db.Uuid
  boardId  String @map("board_id") @db.Uuid
  name     String @db.VarChar(80)
  filter   Json
  position Float

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, position])
  @@map("board_quick_filters")
}

model Label {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(40)
  nameKey   String   @unique @map("name_key") @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at")

  tasks TaskLabel[]

  @@map("labels")
}

model TaskLabel {
  taskId  String @map("task_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}

model Sprint {
  id        String      @id @default(uuid()) @db.Uuid
  boardId   String      @map("board_id") @db.Uuid
  name      String      @db.VarChar(120)
  goal      String?     @db.VarChar(500)
  state     SprintState @default(FUTURE)
  startDate DateTime?   @map("start_date")
  endDate   DateTime?   @map("end_date")
  startedAt DateTime?   @map("started_at")
  closedAt  DateTime?   @map("closed_at")
  position  Float
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  board  Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks  Task[]
  events SprintEvent[]

  @@index([boardId, state])
  @@index([boardId, position])
  @@map("sprints")
}

model SprintEvent {
  id           String          @id @default(uuid()) @db.Uuid
  sprintId     String          @map("sprint_id") @db.Uuid
  taskId       String?         @map("task_id") @db.Uuid
  type         SprintEventType
  storyPoints  Decimal?        @map("story_points") @db.Decimal(5, 1)
  actorUserId  String?         @map("actor_user_id") @db.Uuid
  details      Json?
  createdAt    DateTime        @default(now()) @map("created_at")

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task   Task?  @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([sprintId, createdAt])
  @@index([taskId])
  @@map("sprint_events")
}
